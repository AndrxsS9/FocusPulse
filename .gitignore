# ------------------------------------------------------------------
# Llaves de desarrollador: NUNCA se versionan.
# La llave vive fuera del repo, en %USERPROFILE%\Downloads\FocusPulse-keys
# ------------------------------------------------------------------
developer_key*
*.der
*.pem

# ------------------------------------------------------------------
# Salidas de compilacion de Connect IQ
# ------------------------------------------------------------------
bin/
gen/
mir/
internal-mir/
*.prg
*.prg.debug.xml
*.debug
*.debug.xml
*.iq
*-settings.json

# ------------------------------------------------------------------
# Windows
# ------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# ------------------------------------------------------------------
# Python (entrenamiento del modelo en /ml)
# ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
ml/.venv/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# ------------------------------------------------------------------
# Simulador, registros y temporales
# ------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*~
*.fit
.vscode/

# Datos pesados del pipeline de ML: se regeneran con scripts\train.ps1.
# Las métricas, el informe, los PNG (ml/reports/) y el modelo exportado
# (ml/models/) sí se versionan.
ml/data/*
!ml/data/README.md

