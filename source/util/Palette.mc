//! Paleta de colores de FocusPulse AI.
//!
//! Pensada para la pantalla AMOLED del Forerunner 165: fondo casi negro
//! (menos consumo y menos riesgo de quemado) con texto claro y un acento cian.
module Palette {
    //! Fondo de todas las pantallas.
    const BACKGROUND = 0x07090C;

    //! Texto principal.
    const TEXT = 0xF5F7FA;

    //! Texto secundario (estados, ayudas).
    const TEXT_SECONDARY = 0x9AA4B2;

    //! Acento cian (estado activo, detalles de marca).
    const ACCENT = 0x4CC9F0;
}
