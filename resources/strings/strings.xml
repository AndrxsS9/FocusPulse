    <string id="SettingVibrationSoft">Soft</string>
    <string id="SettingVibrationNormal">Normal</string>
    <string id="SettingVibrationStrong">Strong</string>
    <string id="SettingReducedAnimations">Reduced animations</string>
    <string id="SettingAiConfirmation">AI confirmation</string>
