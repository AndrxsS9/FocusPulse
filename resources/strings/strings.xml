<!-- Textos por defecto (inglés). Los textos en español viven en resources-spa/.
     Cada id debe existir en ambos archivos. Convención de ids: Prefijo por pantalla
     o grupo (Status, Button, Alert, Fatigue, Demo, Setting, AiClass) + nombre. -->
<strings>
    <string id="AppName">FocusPulse AI</string>

    <!-- Estados de la sesión -->
    <string id="StatusPaused">Monitoring paused</string>
    <string id="StatusActive">Guard active</string>
    <string id="StatusCalibrating">Calibrating…</string>
    <string id="StatusSensorUnavailable">Sensor unavailable</string>
    <string id="StatusDemo">Demo mode</string>
    <!-- Marca discreta de la esfera cuando la fuente es simulada. -->
    <string id="BadgeDemo">DEMO</string>

    <!-- Nombre de la actividad grabada en el historial (máx. recomendado 15 caracteres) -->
    <string id="SessionName">Focus guard</string>

    <!-- Botones -->
    <string id="ButtonStartGuard">Start guard</string>
    <string id="ButtonPauseGuard">Pause guard</string>
    <string id="ButtonImAwake">I'm awake</string>

    <!-- Pantalla principal -->
    <string id="LabelAlertness">Alertness</string>
    <!-- Etiqueta corta junto al porcentaje de la esfera (mayúsculas a propósito). -->
    <string id="LabelAlertShort">ALERT</string>

    <!-- Esfera principal. Formatos: $1$, $2$… son valores. -->
    <string id="PercentFormat">$1$%</string>
    <!-- Fecha corta: $1$ día de la semana, $2$ día del mes, $3$ mes (abreviados por el sistema). -->
    <string id="DateFormat">$1$ $3$ $2$</string>
    <!-- No es un texto visible: "lower" pasa a minúsculas el día y el mes del sistema
         (en español "vie 13 nov"); "keep" los deja como vienen ("Fri Nov 13"). -->
    <string id="DateCase">keep</string>

    <!-- Alerta a pantalla completa -->
    <string id="AlertWakeUp">WAKE UP!</string>
    <string id="AlertLevel1">Level 1 of 3</string>
    <string id="AlertLevel2">Level 2 of 3</string>
    <string id="AlertLevel3">Level 3 of 3</string>
    <string id="AlertVibrationSoft">soft vibration</string>
    <string id="AlertVibrationMedium">medium vibration</string>
    <string id="AlertVibrationMax">maximum vibration</string>
    <!-- Con el ajuste "Vibración" apagado (o sin motor). -->
    <string id="AlertVibrationOff">no vibration</string>
    <!-- Segunda línea de la alerta: $1$ nivel (AlertLevelN), $2$ vibración (AlertVibration*, en minúsculas porque va después del punto medio). -->
    <string id="AlertLevelLineFormat">$1$ · $2$</string>
    <string id="AlertCauseNod">Head nod / loss of muscle tone</string>
    <string id="AlertCauseInactivity">Prolonged inactivity</string>

    <!-- Fatiga -->
    <string id="FatigueLabel">Fatigue</string>
    <string id="FatigueRepeatedMicrosleeps">Repeated micro-sleeps · take a 15 min break</string>
    <!-- Aviso de la esfera con la fatiga en Alto, en dos líneas: título (ámbar) y acción.
         Cada línea cabe en unos 290 px (FONT_XTINY): "toma un descanso de 15 min" no cabía. -->
    <string id="FatigueBannerTitle">Repeated micro-sleeps</string>
    <string id="FatigueBannerAction">take a 15 min break</string>
    <string id="FatigueLow">Low</string>
    <string id="FatigueModerate">Moderate</string>
    <string id="FatigueHigh">High</string>

    <!-- Descanso guiado (fatiga alta): título, fin, ayuda de BACK, botón y entrada del menú. -->
    <string id="BreakTitle">Break</string>
    <string id="BreakDone">Break over</string>
    <string id="BreakHint">BACK · cancel</string>
    <string id="ButtonResumeGuard">Resume guard</string>
    <string id="MenuTakeBreak">Take a break</string>

    <!-- Resumen de la guardia (al pausar y en el historial). Fatiga: FatigueLabel y
         Fatigue*. Formatos: $1$, $2$ son números; ResponseFormat lleva segundos y
         décimas con el separador decimal del idioma. ValueNone: sin dato. -->
    <string id="SummaryTitle">Guard summary</string>
    <string id="SummaryDuration">Duration</string>
    <string id="SummaryEpisodes">Episodes</string>
    <string id="SummaryResponse">Avg. response</string>
    <string id="SummaryMaxLevel">Max. level</string>
    <string id="ValueNone">—</string>
    <string id="MaxLevelFormat">$1$ of 3</string>
    <string id="ResponseFormat">$1$.$2$ s</string>
    <string id="DurationSecFormat">$1$ s</string>
    <string id="DurationMinSecFormat">$1$ min $2$ s</string>
    <string id="DurationMinFormat">$1$ min</string>
    <string id="DurationHourFormat">$1$ h $2$ min</string>

    <!-- Historial (menú principal). HistoryItemFormat: $1$ día, $2$ mes abreviado, $3$ hora;
         HistorySubFormat: $1$ duración, $2$ episodios (EpisodesOne / EpisodesFormat). -->
    <string id="MenuHistory">History</string>
    <string id="HistoryCountOne">1 guard</string>
    <string id="HistoryCountFormat">$1$ guards</string>
    <string id="HistoryEmpty">No guards yet</string>
    <string id="HistoryClear">Clear history</string>
    <string id="HistoryClearConfirm">Clear the history?</string>
    <string id="HistoryItemFormat">$2$ $1$ · $3$</string>
    <string id="HistorySubFormat">$1$ · $2$</string>
    <string id="EpisodesOne">1 episode</string>
    <string id="EpisodesFormat">$1$ episodes</string>

    <!-- Modo demo -->
    <string id="DemoTitle">Demo mode</string>
    <string id="DemoSimulateNod">Simulate nod</string>
    <string id="DemoActiveTyping">Active typing</string>
    <string id="DemoProlongedInactivity">Prolonged inactivity</string>
    <string id="DemoMaxAlert">Maximum alert</string>
    <string id="DemoNormalMovement">Normal movement</string>
    <string id="DemoManual">Manual (fixed X/Y/Z)</string>
    <string id="DemoGlance">Glance at the watch</string>

    <!-- Nombres cortos de los escenarios para la línea de la esfera (unos 25 caracteres en total). -->
    <string id="DemoShortNormal">Normal</string>
    <string id="DemoShortTyping">Active typing</string>
    <string id="DemoShortNod">Head nod</string>
    <string id="DemoShortInactivity">Inactivity</string>
    <string id="DemoShortManual">Manual</string>
    <string id="DemoShortGlance">Glance</string>
