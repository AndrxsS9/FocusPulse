    <string id="WarningVisualOnlyTitle">Visual-only alert</string>
    <string id="WarningVisualOnlyShort">No vibration or sound</string>
    <string id="WarningVisualOnlyBody">Alerts will only show on screen. Turn on vibration or sound.</string>

