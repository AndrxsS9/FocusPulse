    <string id="ModelType">Logistic regression · 4 classes</string>
    <string id="ModelVersion">Version</string>
    <string id="ModelAccuracy">Accuracy</string>
    <string id="ModelFalseNods">False nods</string>
    <string id="ModelPercentFormat">$1$.$2$%</string>
    <string id="ModelSynthetic">Trained on synthetic data</string>
    <!-- Acerca de: $1$ es la versión (AppInfo.VERSION). -->
    <string id="AboutVersionFormat">Version $1$</string>
    <string id="AboutDescription">Detects micro-sleeps and wakes you up with progressive vibrations.</string>

    <!-- Ajustes -->
    <string id="SettingsTitle">Settings</string>
    <!-- Subtítulo de Ajustes en el menú principal: $1$ SettingSensitivity, $2$ su valor. -->
    <string id="SettingsSubFormat">$1$: $2$</string>
    <string id="SettingSensitivity">Sensitivity</string>
    <string id="SettingVibration">Vibration</string>
