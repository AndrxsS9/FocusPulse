<!-- Textos por defecto (inglés). Los textos en español viven en resources-spa/.
     Cada id debe existir en ambos archivos. Convención de ids: Prefijo por pantalla
     o grupo (Status, Button, Alert, Fatigue, Demo, Setting, AiClass) + nombre. -->
<strings>
    <string id="AppName">FocusPulse AI</string>

    <!-- Estados de la sesión -->
    <string id="StatusPaused">Monitoring paused</string>
    <string id="StatusActive">Guard active</string>
    <string id="StatusCalibrating">Calibrating…</string>
    <string id="StatusSensorUnavailable">Sensor unavailable</string>
    <string id="StatusDemo">Demo mode</string>
    <!-- Marca discreta de la esfera cuando la fuente es simulada. -->
    <string id="BadgeDemo">DEMO</string>

    <!-- Nombre de la actividad grabada en el historial (máx. recomendado 15 caracteres) -->
    <string id="SessionName">Focus guard</string>

    <!-- Botones -->
    <string id="ButtonStartGuard">Start guard</string>
    <string id="ButtonPauseGuard">Pause guard</string>
    <string id="ButtonImAwake">I'm awake</string>

    <!-- Pantalla principal -->
    <string id="LabelAlertness">Alertness</string>
    <!-- Etiqueta corta junto al porcentaje de la esfera (mayúsculas a propósito). -->
    <string id="LabelAlertShort">ALERT</string>

    <!-- Esfera principal. Formatos: $1$, $2$… son valores. -->
    <string id="PercentFormat">$1$%</string>
    <!-- Fecha corta: $1$ día de la semana, $2$ día del mes, $3$ mes (abreviados por el sistema). -->
    <string id="DateFormat">$1$ $3$ $2$</string>
    <!-- No es un texto visible: "lower" pasa a minúsculas el día y el mes del sistema
         (en español "vie 13 nov"); "keep" los deja como vienen ("Fri Nov 13"). -->
    <string id="DateCase">keep</string>

    <!-- Alerta a pantalla completa -->
    <string id="AlertWakeUp">WAKE UP!</string>
    <string id="AlertLevel1">Level 1 of 3</string>
    <string id="AlertLevel2">Level 2 of 3</string>
    <string id="AlertLevel3">Level 3 of 3</string>
    <string id="AlertVibrationSoft">soft vibration</string>
    <string id="AlertVibrationMedium">medium vibration</string>
    <string id="AlertVibrationMax">maximum vibration</string>
    <!-- Segunda línea de la alerta: $1$ nivel (AlertLevelN), $2$ vibración (AlertVibration*, en minúsculas porque va después del punto medio). -->
    <string id="AlertLevelLineFormat">$1$ · $2$</string>
    <string id="AlertCauseNod">Head nod / loss of muscle tone</string>
    <string id="AlertCauseInactivity">Prolonged inactivity</string>

    <!-- Fatiga -->
    <string id="FatigueLabel">Fatigue</string>
    <string id="FatigueRepeatedMicrosleeps">Repeated micro-sleeps · take a 15 min break</string>
    <!-- Aviso de la esfera con la fatiga en Alto, en dos líneas: título (ámbar) y acción.
         Cada línea cabe en unos 290 px (FONT_XTINY): "toma un descanso de 15 min" no cabía. -->
    <string id="FatigueBannerTitle">Repeated micro-sleeps</string>
    <string id="FatigueBannerAction">take a 15 min break</string>
    <string id="FatigueLow">Low</string>
    <string id="FatigueModerate">Moderate</string>
    <string id="FatigueHigh">High</string>

    <!-- Modo demo -->
    <string id="DemoTitle">Demo mode</string>
    <string id="DemoSimulateNod">Simulate nod</string>
    <string id="DemoActiveTyping">Active typing</string>
    <string id="DemoProlongedInactivity">Prolonged inactivity</string>
    <string id="DemoMaxAlert">Maximum alert</string>
    <string id="DemoNormalMovement">Normal movement</string>
    <string id="DemoManual">Manual (fixed X/Y/Z)</string>

    <!-- Nombres cortos de los escenarios para la línea de la esfera (unos 25 caracteres en total). -->
    <string id="DemoShortNormal">Normal</string>
    <string id="DemoShortTyping">Active typing</string>
    <string id="DemoShortNod">Head nod</string>
    <string id="DemoShortInactivity">Inactivity</string>
    <string id="DemoShortManual">Manual</string>
    <!-- Línea del modo demo en la esfera, en lugar de la fecha: $1$ BadgeDemo, $2$ nombre corto. -->
    <string id="DemoBadgeFormat">$1$ · $2$</string>

    <!-- Menú principal (mantener UP). El título del menú es AppName. -->
    <string id="MenuDemoOn">Simulated data</string>
    <string id="MenuDemoOff">Real sensor</string>
    <string id="MenuScenario">Scenario</string>
    <!-- Probar alerta: los ítems reutilizan AlertLevel1..3 y AlertVibration*. -->
    <string id="MenuTestAlert">Test alert</string>
    <!-- Guion automático: subtítulo para empezarlo o detenerlo ($1$ paso actual, $2$ total). -->
    <string id="MenuScript">Auto script</string>
    <string id="MenuScriptStart">Start</string>
    <string id="MenuScriptStopFormat">Stop · step $1$/$2$</string>
    <!-- Línea de la esfera con el guion en marcha: $1$ paso, $2$ total, $3$ nombre corto. -->
    <string id="ScriptProgressFormat">Script $1$/$2$ · $3$</string>
    <!-- Aviso al terminar el guion (título MenuScript). -->
    <string id="ToastScriptDone">Complete</string>
    <string id="MenuAbout">About</string>
    <!-- Acerca de: $1$ es la versión (AppInfo.VERSION). -->
    <string id="AboutVersionFormat">Version $1$</string>
    <string id="AboutDescription">Detects micro-sleeps and wakes you up with progressive vibrations.</string>

    <!-- Ajustes -->
    <string id="SettingsTitle">Settings</string>
    <string id="SettingSensitivity">Sensitivity</string>
    <string id="SettingVibration">Vibration</string>
    <string id="SettingSound">Sound</string>
    <string id="SettingValueLow">Low</string>
    <string id="SettingValueMedium">Medium</string>
    <string id="SettingValueHigh">High</string>
    <string id="SettingValueOn">On</string>
    <string id="SettingValueOff">Off</string>
    <string id="SettingRecordActivity">Record guard as activity</string>

    <!-- Clases del modelo IA -->
    <string id="AiClassActive">Active</string>
    <string id="AiClassNormal">Normal</string>
    <string id="AiClassNod">Nodding</string>
    <string id="AiClassInert">Inert</string>

    <!-- Menú de depuración (solo en compilaciones de depuración) -->
    <string id="DebugMenuTitle">Debug</string>
    <string id="DebugSource">Data source</string>
    <string id="DebugSourceReal">Real sensor</string>
    <string id="DebugSimulated">Simulated</string>
    <string id="DebugStyleGuide">Style guide</string>
    <string id="DebugTelemetry">Live telemetry</string>
    <!-- Probar la alerta a pantalla completa: $1$ es el nivel (1–3). -->
    <string id="DebugTestAlertFormat">Test alert level $1$</string>
    <string id="DebugRecording">Recording</string>
    <string id="DebugNotRecording">Not recording</string>
    <!-- Formatos de la telemetría en vivo: $1$, $2$… son valores numéricos. -->
    <string id="DebugAxesFormat">X $1$  Y $2$  Z $3$</string>
    <string id="DebugVarianceFormat">Variance $1$ mg²</string>
    <string id="DebugJerkFormat">Jerk $1$ mg · peak $2$</string>
    <string id="DebugStillFormat">Still for $1$ s</string>
    <string id="DebugRateFormat">$1$ Hz of $2$ Hz</string>
    <string id="DebugSamplesFormat">$1$ samples</string>
    <!-- Detector en vivo -->
    <string id="DebugDetector">Live detector</string>
    <string id="DetectorWatching">Watching</string>
    <string id="DetectorFallDetected">Fall detected</string>
    <!-- $1$ es el nombre del evento (EventNod o EventInactivity). -->
    <string id="DetectorEventFormat">Event: $1$</string>
    <string id="EventNod">Nod</string>
    <string id="EventInactivity">Inactivity</string>
    <!-- $1$ media y $2$ desviación de ln(varianza + 1); $3$ umbral de quietud (mg²).
         Corto: va en una línea de unos 300 px. -->
    <string id="DebugBaselineFormat">Base $1$±$2$ · limit $3$</string>
    <!-- $1$ segundos de quietud; $2$ cambio de inclinación en grados. -->
    <string id="DebugStillTiltFormat">Still $1$ s · tilt $2$°</string>
    <!-- $1$ evento; $2$ hora (HH:MM:SS). -->
    <string id="DebugLastEventFormat">Last: $1$ $2$</string>
    <string id="DebugNoEvents">No events yet</string>

    <!-- Guía de estilo (pantalla oculta de depuración) -->
    <string id="StyleGuidePalette">Palette</string>
    <string id="StyleGuideTypography">Typography</string>
    <string id="StyleGuideTexts">Texts</string>
    <string id="StyleGuideComponents">Components</string>
    <string id="StyleGuideAlerts">Alerts</string>
    <string id="TypeRoleTime">Time</string>
    <string id="TypeRoleNumber">Number</string>
    <string id="TypeRoleAlert">Alert</string>
    <string id="TypeRoleTitle">Title</string>
    <string id="TypeRoleBody">Body</string>
    <string id="TypeRoleLabel">Label</string>
</strings>
