    <string id="DemoBadgeFormat">$1$ · $2$</string>

    <!-- Menú principal (mantener UP). El título del menú es AppName. -->
    <string id="MenuDemoOn">Simulated data</string>
    <string id="MenuDemoOff">Real sensor</string>
    <string id="MenuScenario">Scenario</string>
    <!-- Probar alerta: los ítems reutilizan AlertLevel1..3 y AlertVibration*. -->
    <string id="MenuTestAlert">Test alert</string>
    <!-- Guion automático: subtítulo para empezarlo o detenerlo ($1$ paso actual, $2$ total). -->
    <string id="MenuScript">Auto script</string>
    <string id="MenuScriptStart">Start</string>
    <string id="MenuScriptStopFormat">Stop · step $1$/$2$</string>
    <!-- Línea de la esfera con el guion en marcha: $1$ paso, $2$ total, $3$ nombre corto. -->
    <string id="ScriptProgressFormat">Script $1$/$2$ · $3$</string>
    <string id="MenuAbout">About</string>
    <!-- Pantalla "Modelo IA" (menú principal). ModelPercentFormat: $1$ entero, $2$ décima. -->
