    <string id="DebugSource">Data source</string>
    <string id="DebugSourceReal">Real sensor</string>
    <string id="DebugSimulated">Simulated</string>
    <string id="DebugStyleGuide">Style guide</string>
    <string id="DebugTelemetry">Live telemetry</string>
