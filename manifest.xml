<?xml version="1.0" encoding="UTF-8"?>
<!--
    FocusPulse AI - manifest de la aplicacion Connect IQ.

    PENDIENTE DE VERIFICAR con el SDK instalado (ver docs/PENDIENTES.md):
      - id exacto del producto Forerunner 165 ("fr165"; existe tambien la variante "fr165m").
      - minApiLevel: se fijo 3.4.0 de forma conservadora (Sensor.registerSensorDataListener
        requiere 3.0.0); subirlo si se necesitan APIs mas nuevas.
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application
        id="6600d3c23b8a4e89827e17ef16db01e8"
        type="watch-app"
        name="@Strings.AppName"
        entry="FocusPulseApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.4.0">

        <iq:products>
            <iq:product id="fr165"/>
        </iq:products>

        <iq:permissions>
            <!-- Acceso al acelerometro via Toybox.Sensor -->
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>spa</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
