<?xml version="1.0" encoding="UTF-8"?>
<!--
    FocusPulse AI - manifest de la aplicacion Connect IQ.

    Productos verificados con el SDK 9.3.0 (Devices/<id>/compiler.json):
      - fr165  (Forerunner 165)       - API 5.2.0, 390x390 AMOLED, tactil.
      - fr165m (Forerunner 165 Music) - mismo hardware de pantalla, teclas y sensores.
    minApiLevel = nivel de API real de ambos (5.2.0).
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application
        id="6600d3c23b8a4e89827e17ef16db01e8"
        type="watch-app"
        name="@Strings.AppName"
        entry="FocusPulseApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="5.2.0">

        <iq:products>
            <iq:product id="fr165"/>
            <iq:product id="fr165m"/>
        </iq:products>

        <iq:permissions>
            <!-- Acceso al acelerometro via Toybox.Sensor -->
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>spa</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
